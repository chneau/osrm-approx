{
  "name": "testing-ml-tte",
  "version": "1.0.0",
  "private": true,
  "description": "Ultra-fast OSRM approximation service for Greater Manchester (.NET 10 + compiled tree ensemble)",
  "scripts": {
    "data": "cd python && uv run generate_grid.py && uv run fetch_osrm_matrix.py",
    "data:offnetwork": "cd python && uv run gen_offnetwork.py",
    "density": "cd python && uv run build_road_density.py",
    "experiments": "cd python && uv run experiments.py --train-rows 2000000 --test-per-bucket 4000",
    "grid": "cd python && uv run generate_grid.py",
    "matrix": "cd python && uv run fetch_osrm_matrix.py",
    "train": "cd python && uv run train_export_onnx.py && uv run export_binary.py",
    "osrm:init": "docker compose --profile init up osrm-init",
    "osrm:up": "docker compose --profile serve up -d osrm-routed",
    "osrm:down": "docker compose --profile serve down",
    "serve": "dotnet run --project server/RoutingService.csproj -c Release",
    "build": "dotnet build server/RoutingService.csproj -c Release",
    "test": "dotnet test tests/RoutingService.Tests.csproj -c Release",
    "bench": "uv run tests/benchmark.py",
    "stats": "uv run tests/osrm_vs_onnx.py",
    "stats:stratified": "uv run tests/osrm_vs_onnx.py --stratify --md tests/OSRM_VS_ONNX_STRATIFIED.md --out tests/osrm_vs_onnx_stratified.json",
    "stats:on-network": "uv run tests/osrm_vs_onnx.py --on-network-only --md tests/OSRM_VS_ONNX_ON_NETWORK.md --out tests/osrm_vs_onnx_on_network.json"
  }
}
