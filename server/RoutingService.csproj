<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RoutingService</RootNamespace>
    <AssemblyName>RoutingService</AssemblyName>
    <!-- Workstation GC keeps the resident footprint small; this service is
         latency-bound on a single tiny tensor, not allocation-throughput bound. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RoutingService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="models\model.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Update="models\model.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Update="models\model_metadata.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
